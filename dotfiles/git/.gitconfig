[core]
    editor = nvim
[commit]
    verbose = True
[includeIf "gitdir:~/code/work/"]
    path = ~/.gitconfig-work
[includeIf "gitdir:~/code/personal/"]
    path = ~/.gitconfig-personal
[difftool]
    prompt = false
[pager]
    difftool = true
[pull]
    rebase = false
[safe]
    directory = /site
[push]
    autoSetupRemote = true
